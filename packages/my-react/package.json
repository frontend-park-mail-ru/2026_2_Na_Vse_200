{
    "name": "@navse200/my-react",
    "version": "1.0.0",
    "private": true,
    "description": "JSX, DOM rendering and state hooks for the Na Vse 200 application",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }

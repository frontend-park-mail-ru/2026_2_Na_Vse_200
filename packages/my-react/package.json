        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}

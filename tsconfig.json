{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": false,
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "jsx": "react",
        "jsxFactory": "createElement",
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": ["src", "*.config.ts"],
    "exclude": ["src/sw.ts"]
}

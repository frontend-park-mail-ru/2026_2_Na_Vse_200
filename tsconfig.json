{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react",
        "jsxFactory": "createElement",
        "allowJs": true,
        "checkJs": false,
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client"]
    },
    "include": ["src"]
}

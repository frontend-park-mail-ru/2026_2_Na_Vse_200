{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "jsx": "react",
        "jsxFactory": "createElement",
        "skipLibCheck": true
    },
    "include": ["src", "index.ts", "createElement.ts", "render.ts", "types.ts"]
}

        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "happy-dom": "^21.0.4",
        "prettier": "3.9.9",
        "sass": "^1.107.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.0"
    }
}

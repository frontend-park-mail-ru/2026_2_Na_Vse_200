{
    "name": "na-vse-200",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "scripts": {
        "start": "npm run build:packages && vite --host 127.0.0.1",
        "build": "npm run typecheck && vite build",
        "build:packages": "npm run build --workspace @navse200/my-react",
        "typecheck": "npm run build:packages && tsc --noEmit && tsc -p tsconfig.sw.json",
        "preview": "vite preview --host 127.0.0.1",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@babel/plugin-transform-react-jsx": "^8.0.1",
        "@babel/preset-typescript": "^8.0.7",
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "prettier": "3.9.9",
        "sass": "^1.107.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^2.0.0",
        "workbox-cacheable-response": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "dependencies": {
        "@navse200/my-react": "1.0.0",
        "idb": "^8.0.4"
    }
}

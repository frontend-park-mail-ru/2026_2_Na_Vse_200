{
    "name": "na-vse-200",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "vite --host 127.0.0.1",
        "build": "npm run typecheck && vite build",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview --host 127.0.0.1",
        "lint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0",
        "test": "node --test tests/*.test.ts tests/*.test.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^24.19.2",
        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "prettier": "3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.0",
        "@babel/core": "^8.1.0",
        "@babel/plugin-transform-react-jsx": "^8.0.1",
        "@babel/preset-typescript": "^8.0.7",
        "sass": "^1.107.1"
    },
    "engines": {
        "node": ">=24.11.0"
    }
}
